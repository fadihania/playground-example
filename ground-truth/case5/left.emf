@namespace(uri="aadl2")
package aadl2;

abstract class ComponentPrototype extends Prototype, SubcomponentType, FeatureClassifier {
	attr boolean array;
	ref ComponentClassifier constrainingClassifier;
}

class ComponentPrototypeActual extends ArrayableElement {
	attr ComponentCategory category;
	ref PrototypeBinding binding;
	ref SubcomponentType subcomponentType;
}

abstract class Prototype {
	ref Prototype refined;
}

abstract class Element {
	
}

abstract class ArrayableElement extends Element {
	
}

abstract class PrototypeBinding {
	
}

abstract class FeatureClassifier {
	
}

abstract class SubcomponentType {
	
}

abstract class ComponentClassifier {
	
}


class AbstractPrototype {
	
}

class BusPrototype {
	
}

class DataPrototype {
	
}

class DevicePrototype {

}

class MemoryPrototype {
	
}

class ProcessPrototype {
	
}

class ProcessorPrototype {
	
}

class SubprogramPrototype {
	
}

class SubprogramGroupPrototype{
	
}

class SystemPrototype {
	
}

class ThreadPrototype {
	
}

class ThreadGroupPrototype {
	
}

class VirtualBusPrototype {
	
}

class VirtualProcessorPrototype {
	
}

enum ComponentCategory {
	abstrct=0;
	bus=1;
    data=2;
    device=3;
    memory=4;
    process=5;
    processor=6;
    subprogram=7;
    subprogramGroup=8;
    system=9;
    thread=10;
    threadGroup=11;
    virtualBus=12;
    virtualProcessor=13;
}