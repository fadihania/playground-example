package aadl2;

enum ComponentCategory {
  ~abstract = 0;
  bus = 1;
  data = 2;
  device = 3;
  memory = 4;
  process = 5;
  processor = 6;
  subprogram = 7;
  subprogramGroup = 8;
  system = 9;
  thread = 10;
  threadGroup = 11;
  virtualBus = 12;
  virtualProcessor = 13;
}

