<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" name="aadl2" nsURI="aadl2" nsPrefix="">
  <eClassifiers xsi:type="ecore:EClass" name="ComponentImplementation" abstract="true">
    <eStructuralFeatures xsi:type="ecore:EReference" name="ownedAbstractSubcomponent"
        upperBound="-1" eType="#//AbstractSubcomponent" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="ownedAccessConnection"
        upperBound="-1" eType="#//AccessConnection" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="subcomponents" upperBound="-1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EFeatureMapEntry"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="connections" upperBound="-1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EFeatureMapEntry"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="flows" upperBound="-1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EFeatureMapEntry"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="type" lowerBound="1" eType="#//ComponentType"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="ownedSubcomponent" upperBound="-1"
        eType="#//Subcomponent" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="extended" eType="#//ComponentImplementation"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="ownedFlowImplementation"
        upperBound="-1" eType="#//FlowImplementation" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="ownedConnection" upperBound="-1"
        eType="#//Connection" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="ownedExtension" eType="#//ImplementationExtension"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="ownedRealization" lowerBound="1"
        eType="#//Realization"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="ownedEndToEndFlow" upperBound="-1"
        eType="#//EndToEndFlow" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="ownedParameterConnection"
        upperBound="-1" eType="#//ParameterConnection" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="ownedPortConnection" upperBound="-1"
        eType="#//PortConnection" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="ownedFeatureConnection"
        upperBound="-1" eType="#//FeatureConnection" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="ownedFeatureGroupConnection"
        upperBound="-1" eType="#//FeatureGroupConnection" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="ownedProcessorSubprogram"
        upperBound="-1" eType="#//ProcessorSubprogram" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="noSubcomponents" lowerBound="1"
        eType="#//Boolean"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="noConnections" lowerBound="1"
        eType="#//Boolean"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="noCalls" lowerBound="1"
        eType="#//Boolean"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="AbstractSubcomponent"/>
  <eClassifiers xsi:type="ecore:EClass" name="AccessConnection"/>
  <eClassifiers xsi:type="ecore:EClass" name="ComponentClassifier" abstract="true">
    <eStructuralFeatures xsi:type="ecore:EReference" name="ownedInternalEvent" upperBound="-1"
        eType="#//InternalEvent" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="ownedProcessorPort" upperBound="-1"
        eType="#//ProcessorPort" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="InternalEvent" eSuperTypes="#//PortConnectionEnd"/>
  <eClassifiers xsi:type="ecore:EClass" name="ComponentType" abstract="true"/>
  <eClassifiers xsi:type="ecore:EClass" name="Subcomponent" abstract="true"/>
  <eClassifiers xsi:type="ecore:EClass" name="FlowImplementation"/>
  <eClassifiers xsi:type="ecore:EClass" name="Connection" abstract="true"/>
  <eClassifiers xsi:type="ecore:EClass" name="ImplementationExtension"/>
  <eClassifiers xsi:type="ecore:EClass" name="Realization"/>
  <eClassifiers xsi:type="ecore:EClass" name="EndToEndFlow"/>
  <eClassifiers xsi:type="ecore:EClass" name="ParameterConnection"/>
  <eClassifiers xsi:type="ecore:EClass" name="PortConnection"/>
  <eClassifiers xsi:type="ecore:EClass" name="FeatureConnection"/>
  <eClassifiers xsi:type="ecore:EClass" name="FeatureGroupConnection"/>
  <eClassifiers xsi:type="ecore:EClass" name="ProcessorSubprogram" eSuperTypes="#//AccessConnectionEnd"/>
  <eClassifiers xsi:type="ecore:EDataType" name="Boolean" instanceClassName="boolean"/>
  <eClassifiers xsi:type="ecore:EClass" name="ComponentPrototype"/>
  <eClassifiers xsi:type="ecore:EClass" name="ComponentPrototypeActual" abstract="true"/>
  <eClassifiers xsi:type="ecore:EClass" name="AccessConnectionEnd" abstract="true"/>
  <eClassifiers xsi:type="ecore:EClass" name="ProcessorPort" eSuperTypes="#//PortConnectionEnd"/>
  <eClassifiers xsi:type="ecore:EClass" name="PortConnectionEnd" abstract="true"/>
</ecore:EPackage>
