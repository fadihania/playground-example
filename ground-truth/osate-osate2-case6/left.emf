package aadl2;

abstract class ComponentType {
  ref Feature[*] ownedFeature;
  ref ComponentType[0..1] extended;
  val FlowSpecification[*] ownedFlowSpecification;
  val TypeExtension[0..1] ownedExtension;
  val FeatureGroup[*] ownedFeatureGroup;
  val AbstractFeature[*] ownedAbstractFeature;
  attr Boolean[1] noFeatures;
}

abstract class Feature {
}

class FlowSpecification {
}

class TypeExtension {
}

class FeatureGroup {
}

class AbstractFeature {
}

datatype Boolean : boolean;
